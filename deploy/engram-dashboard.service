[Unit]
Description=Dashboard local de Engram (WebUI)
# Proxy minimalista sobre la API oficial `engram serve`; no toca SQLite directamente.
# Reinicio razonable, sin bucles agresivos.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/.local/share/engram-dashboard-local
ExecStart=/usr/bin/python3 %h/.local/share/engram-dashboard-local/server.py
Restart=on-failure
RestartSec=3
# Endurecimiento que no interfiere con ~/.engram ni con el spawn de `engram serve`.
# Sin ProtectHome: el daemon necesita escribir en %h/.engram (SQLite WAL).
NoNewPrivileges=true

[Install]
WantedBy=default.target
